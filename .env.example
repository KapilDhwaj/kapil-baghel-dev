# ───────────────────────────────────────────────
# Gemini AI
# ───────────────────────────────────────────────
# Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ───────────────────────────────────────────────
# Supabase (PostgreSQL cloud database)
# ───────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
# SUPABASE_URL is the "Project URL"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Use the SERVICE ROLE key (secret) for server-side API routes.
# NEVER expose this key in the React frontend / client-side code.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ───────────────────────────────────────────────
# App URL (optional)
# ───────────────────────────────────────────────
APP_URL="YOUR_VERCEL_DEPLOYMENT_URL"
